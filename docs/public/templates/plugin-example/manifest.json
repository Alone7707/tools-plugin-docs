{
  "code": "plugin_example",
  "name": "插件开发示例",
  "version": "1.0.0",
  "description": "可直接运行的插件模板：演示进入动作、剪贴板、隔离存储、系统通知与宿主顶栏的副标题 / 分离载荷。",
  "author": "AToolBox",
  "entry": "index.js",
  "runtime": "vue",
  "category": "开发工具",
  "icon": "🧩",
  "keywords": ["example", "示例", "模板", "插件开发"],
  "tags": ["模板", "本地调试"],
  "permissions": ["clipboard:write"],
  "features": [
    {
      "name": "文本工作台",
      "description": "统计字符、单词与行数，并演示宿主 API",
      "code": "main",
      "cmds": ["example", "示例", { "type": "over", "minLength": 1, "maxLength": 5000 }]
    }
  ],
  "clipboardRules": [],
  "config": {
    "showStats": true,
    "placeholder": "在这里输入文本，或从主搜索框带内容进来"
  },
  "changelog": [
    { "version": "1.0.0", "notes": "首个版本" }
  ]
}
